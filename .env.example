# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ── Server ──────────────────────────────────────────────────
PORT="4000"
NODE_ENV="development"
APP_URL="http://localhost:4000"
BETTER_AUTH_URL="http://localhost:4000"
FRONTEND_APP_URL="http://localhost:3000"
# Comma-separated list of allowed frontend origins (exact match, no wildcards)
FRONTEND_APP_URLS="http://localhost:3000"

# ── Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
BETTER_AUTH_SECRET=""
WATCH_TOKEN_SECRET=""

# ── Social login (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── Email (optional; Resend preferred, SMTP fallback) ───────
RESEND_API_KEY=""
EMAIL_FROM="NGV <onboarding@resend.dev>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
REQUIRE_EMAIL_VERIFICATION="false"

# ── Seed (npm run seed) ─────────────────────────────────────
SEED_ADMIN_EMAIL="admin@ngv.local"
SEED_ADMIN_PASSWORD=""
SEED_USER_EMAIL="user@ngv.local"
SEED_USER_PASSWORD=""
